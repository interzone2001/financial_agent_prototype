# Copy to .env at the repo root (worktrees symlink to it). Never commit .env.

# --- REQUIRED for real mode (APP_MODE unset) ---------------------------------
# Claude: claude-sonnet-5 (agents) + claude-haiku-4-5 (router, advice check)
ANTHROPIC_API_KEY=sk-ant-...
# Free key: https://www.alphavantage.co/support/#api-key  (25 requests/day)
ALPHA_VANTAGE_API_KEY=your-alpha-vantage-key
# SEC requires a descriptive User-Agent with a contact email
SEC_USER_AGENT="YourAppName your-email@example.com"

# --- REQUIRED for tracing (spec §3.6) ----------------------------------------
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_PROJECT=financial-agent-prototype

# --- OPTIONAL ----------------------------------------------------------------
# APP_MODE=stub serves fixture data offline with no keys (frontend dev, tests)
# APP_MODE=stub
# Where caches, checkpoints and Chroma live (default: <repo>/data)
# DATA_DIR=./data
